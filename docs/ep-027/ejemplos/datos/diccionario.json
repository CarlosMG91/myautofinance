{
  "kind": "autofinance.dataDictionary",
  "formatVersion": 1,
  "currency": "EUR",
  "csv": {
    "encoding": "UTF-8",
    "bom": false,
    "delimiter": ";",
    "recordTerminator": "CRLF",
    "quote": "\"",
